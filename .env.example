# Sydecrew API (the Sydecrew-be repo).
# Leave empty to use the defaults: http://10.0.2.2:4000 on the Android emulator, http://localhost:4000 elsewhere.
# Android emulator: http://10.0.2.2:4000. Real phone: your computer's LAN address, e.g. http://192.168.1.20:4000
# ("localhost" on a phone is the phone itself; the app warns in development).
# The API builds photo upload / preview links from its own PUBLIC_API_URL: set it in Sydecrew-be/.env
# to the SAME address you use here, or uploads and photo previews will fail on the phone.
EXPO_PUBLIC_API_URL=

# Public website, for the legal pages linked from Settings (terms, privacy, refunds, community guidelines).
EXPO_PUBLIC_SITE_URL=https://sydecrew.com
