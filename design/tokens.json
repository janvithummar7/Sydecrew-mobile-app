  "z": { "base": 0, "sticky": 10, "header": 40, "overlay": 60, "modal": 70, "toast": 80 },
  "motion": {
    "duration": { "fast": 200, "base": 450, "slow": 900 },
    "easing": { "outExpo": [0.16, 1, 0.3, 1], "outQuart": [0.25, 1, 0.5, 1], "inOutQuart": [0.76, 0, 0.24, 1] }
  },
  "touchTarget": 44
}
