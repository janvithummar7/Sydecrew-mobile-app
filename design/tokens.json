{
  "$description": "Sydecrew design tokens: the single source for web and mobile (decision G: ink / lavender / lime / fog, dark-first). Edit here, then `npm run tokens:gen` in Sydecrew-web, and copy this file to Sydecrew-mobile-app/design/tokens.json and run `npm run tokens:gen` there. `tokens:check` fails on drift and on any text pair below 4.5:1.",
  "version": 1,
  "color": {
    "ink": { "950": "#08070c", "900": "#0e0c14", "850": "#13111a", "800": "#1a1723", "700": "#262230", "600": "#3a3546" },
    "plum": { "950": "#110d1f", "900": "#1a1430" },
    "fog": { "50": "#faf9fc", "100": "#f3f1f8", "300": "#c9c4d6", "400": "#aca6ba", "500": "#8d879c" },
    "lavender": { "100": "#efeaff", "200": "#ddd4ff", "300": "#c8baff", "400": "#b29fff", "500": "#9a84f5", "700": "#4c3e8f", "900": "#221a42" },
    "lime": { "200": "#f0ffc4", "300": "#e3ff8a", "400": "#d4ff4f", "500": "#b9e636" },
    "red": { "300": "#fca5a5", "400": "#f87171", "900": "#3b1219" },
    "amber": { "300": "#fcd34d", "900": "#3a2a08" },
    "green": { "300": "#86efac", "900": "#0f2e1c" },
    "white": "#ffffff",
    "black": "#000000"
  },
  "alpha": {
    "surface": "rgba(255,255,255,0.04)",
    "surfaceStrong": "rgba(255,255,255,0.07)",
    "border": "rgba(255,255,255,0.12)",
    "borderStrong": "rgba(255,255,255,0.25)",
    "divider": "rgba(255,255,255,0.06)",
    "scrim": "rgba(8,7,12,0.72)"
  },
  "semantic": {
    "bg": "ink.950",
    "bgRaised": "ink.900",
    "bgCard": "ink.850",
    "text": "fog.100",
    "textStrong": "fog.50",
    "textMuted": "fog.400",
    "textSubtle": "fog.500",
    "accent": "lime.400",
    "onAccent": "ink.950",
    "brand": "lavender.300",
    "onBrand": "ink.950",
    "focus": "lavender.300",
    "danger": "red.400",
    "dangerText": "red.300",
    "dangerBg": "red.900",
    "warningText": "amber.300",
    "warningBg": "amber.900",
    "successText": "green.300",
    "successBg": "green.900"
  },
  "contrastPairs": [
    ["text", "bg"], ["textStrong", "bg"], ["textMuted", "bg"], ["textSubtle", "bg"],
    ["text", "bgRaised"], ["textMuted", "bgRaised"], ["text", "bgCard"], ["textMuted", "bgCard"],
    ["onAccent", "accent"], ["onBrand", "brand"], ["brand", "bg"], ["accent", "bg"],
    ["dangerText", "bg"], ["dangerText", "dangerBg"], ["warningText", "warningBg"], ["successText", "successBg"]
  ],
  "font": {
    "sans": { "family": "Geist", "web": "var(--font-geist), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif", "mobile": { "regular": "Geist_400Regular", "medium": "Geist_500Medium", "semibold": "Geist_600SemiBold" } },
    "serif": { "family": "Instrument Serif", "web": "var(--font-instrument), ui-serif, Georgia, \"Times New Roman\", serif", "mobile": { "regular": "InstrumentSerif_400Regular", "italic": "InstrumentSerif_400Regular_Italic" } }
  },
  "type": {
    "display": { "size": 34, "line": 38, "weight": 600, "tracking": -1 },
    "title": { "size": 26, "line": 31, "weight": 600, "tracking": -0.5 },
    "heading": { "size": 18, "line": 24, "weight": 600, "tracking": 0 },
    "body": { "size": 16, "line": 23, "weight": 400, "tracking": 0 },
    "small": { "size": 14, "line": 20, "weight": 400, "tracking": 0 },
    "caption": { "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "eyebrow": { "size": 12, "line": 14, "weight": 600, "tracking": 2, "uppercase": true }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
