{
  "name": "sydecrew-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~8.28.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && node scripts/check-copy.js && node scripts/check-hex.js && node scripts/secret-check.js --env",
    "lint:copy": "node scripts/check-copy.js",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "typecheck": "node scripts/typed-routes.js && tsc --noEmit",
    "lint:hex": "node scripts/check-hex.js",
    "tokens:gen": "node scripts/tokens.js mobile",
    "tokens:check": "node scripts/tokens.js mobile --check",
    "contract:gen": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "brand:gen": "node scripts/brand.js",
    "prepare": "simple-git-hooks",
    "precheck": "node scripts/secret-check.js --tracked",
    "env:check": "node scripts/secret-check.js --env"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/secret-check.js --staged"
  },
  "engines": {
    "node": ">=24"
  }
}
